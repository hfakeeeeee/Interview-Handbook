rules_version = '2';

service cloud.firestore {
  function localizedText(value) {
    return value is map
      && value.keys().hasOnly(['en', 'vi'])
      && value.en is string
      && value.vi is string;
  }

  function validQuestionPayload(data) {
    return data.keys().hasOnly([
        'categoryId',
        'question',
        'answer',
        'createdAt',
        'updatedAt'
      ])
      && data.categoryId is string
      && data.categoryId.size() > 0
      && localizedText(data.question)
      && localizedText(data.answer)
      && (
        (data.question.en.size() > 0 && data.answer.en.size() > 0)
        || (data.question.vi.size() > 0 && data.answer.vi.size() > 0)
      );
  }

  match /databases/{database}/documents {
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
          'name',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;

      allow update: if request.resource.data.keys().hasOnly([
          'name',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;

      allow delete: if true;
    }

    match /questions/{questionId} {
      allow read: if true;
      allow create: if validQuestionPayload(request.resource.data);
      allow update: if validQuestionPayload(request.resource.data);

      allow delete: if true;
    }
  }
}
